# Tapo account credentials (the email/password you use in the Tapo mobile app).
# Needed for the KLAP handshake on newer firmware. Older firmware accepts the
# same credentials as the "device account" set during pairing.
TAPO_EMAIL=you@example.com
TAPO_PASSWORD=your-password

# Known plug addresses, comma separated. Used as a fallback/override when
# discovery is blocked (AP isolation, VLAN, hotspot). Leave empty to rely on
# discovery only.
#
# The sync job needs the ГПВ sub-queue each address sits on, written after a
# colon: 192.168.68.62:3.1. Which sub-queue it is comes from
# https://www.cherkasyoblenergo.com/off or the Cherkasyoblenergo_bot. The queue
# is optional for the discovery/probe/schedule tools, but sync refuses to run
# without it -- a wrong queue is worse than no answer, because it switches the
# boiler off at hours the grid is up.
TAPO_PLUGS=192.168.68.62:3.1,192.168.68.63:3.1

# Telegram bot that posts schedule updates to a channel. Create it with
# @BotFather, then add it to the channel as an administrator with the right to
# post -- membership alone is not enough. TELEGRAM_CHAT_ID is the channel id
# (negative, starts with -100 for channels and supergroups). Both are optional:
# without them the sync still applies rules, it just stays silent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
